# 统一换行符：Windows 默认 core.autocrlf=true，克隆时会把 .sh 变成 CRLF，
# bash 会直接报 $'\r': command not found —— 这会让学员在第一条命令就失败。
*.sh    text eol=lf
*.py    text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.svg   text eol=lf
.gitignore     text eol=lf
.gitattributes text eol=lf

# 二进制资源不做换行转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.mp4  binary
*.wav  binary
*.mp3  binary
